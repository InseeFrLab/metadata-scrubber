@prefix ex: <http://example.org/ddi-align/> .


ex:CodeListDup1
  a rr:TriplesMap ;
  rr:subjectMap [ rr:constant <> ] ;
  rr:predicateObjectMap [
    rr:predicate skos:closeMatch ;
    rr:object <>
  ] ;
  rr:predicateObjectMap [
    rr:predicate ex:similarityScore ;
    rr:objectMap [
      rr:constant "1.000"^^xsd:decimal
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rr:constant " ↔ "
    ]
  ] .

