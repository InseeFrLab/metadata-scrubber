ex:VariableDup1
  a rr:TriplesMap ;
  rr:subjectMap [ rr:constant <> ] ;
  rr:predicateObjectMap [
    rr:predicate owl:sameAs ;
    rr:object <>
  ] ;
  rr:predicateObjectMap [
    rr:predicate ex:similarityScore ;
    rr:objectMap [
      rr:constant "0.946"^^xsd:decimal
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rr:constant "Libellé act. éco. employeur avant 1998 ↔ Libellé act. éco. employeur en 1998"
    ]
  ] .

